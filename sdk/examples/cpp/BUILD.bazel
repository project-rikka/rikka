load("//bazel/cc:defs.bzl", "rikka_cc_binary")

[
    rikka_cc_binary(
        name = source.removesuffix(".cpp"),
        srcs = [source],
        copts = [
            "-std=c++20",
            "-Wall",
            "-Wextra",
            "-Werror",
            "-pedantic",
        ],
        deps = ["//sdk/bindings/cpp"],
    )
    for source in glob(["*.cpp"])
]

exports_files(
    ["counter.cpp"],
    visibility = ["//website:__pkg__"],
)
