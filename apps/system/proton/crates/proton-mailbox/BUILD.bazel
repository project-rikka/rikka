load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "proton-mailbox",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/proton:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-sync",
        "//crates/proton/rikka-proton-account",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-mail",
        "//crates/proton/rikka-proton-pgp",
        "//crates/ui/rikka-markdown",
        "//crates/web/rikka-html",
        "@crates//:futures-util",
        "@crates//:jiff",
        "@crates//:percent-encoding",
        "@crates//:serde",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:url",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":proton-mailbox",
        "//crates/proton/rikka-proton-account",
        "//crates/proton/rikka-proton-mail",
        "@crates//:jiff",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)
