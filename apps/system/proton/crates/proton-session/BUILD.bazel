load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "proton-session",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/proton:__subpackages__",
    ],
    deps = [
        "//crates/desktop/rikka-secrets",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-sync",
        "//crates/proton/rikka-proton-account",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-cache",
        "//crates/proton/rikka-proton-client",
        "//crates/proton/rikka-proton-key-transparency",
        "//crates/proton/rikka-proton-pgp",
        "@crates//:serde",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":proton-session",
        "//crates/desktop/rikka-secrets",
        "//crates/desktop/rikka-test-keyring",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-cache",
        "//crates/proton/rikka-proton-client",
        "//crates/proton/rikka-proton-pgp",
        "//crates/proton/rikka-test-proton",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
