load("//bazel/rust:defs.bzl", "rikka_library")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "proton-config",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/proton:__subpackages__",
    ],
    deps = [
        "//crates/session/rikka-settings",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "proton_config::Config::schema",
    deps = [":proton-config"],
)
