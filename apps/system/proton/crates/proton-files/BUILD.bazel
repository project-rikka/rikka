load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "proton-files",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/proton:__subpackages__",
    ],
    deps = [
        "//crates/desktop/rikka-open",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-format",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-image",
        "//crates/media/rikka-media",
        "//crates/media/rikka-media-format",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-cache",
        "//crates/proton/rikka-proton-drive",
        "//crates/proton/rikka-proton-names",
        "@crates//:futures-util",
        "@crates//:jiff",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":proton-files",
        "//crates/graphics/rikka-image",
        "//crates/proton/rikka-proton-drive",
        "@crates//:jiff",
        "@crates//:tempfile",
    ],
)
