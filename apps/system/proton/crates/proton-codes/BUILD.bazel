load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "proton-codes",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/proton:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-format",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-authenticator",
        "//crates/proton/rikka-proton-pgp",
        "@crates//:jiff",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":proton-codes",
        "//crates/proton/rikka-proton-authenticator",
        "@crates//:jiff",
    ],
)
