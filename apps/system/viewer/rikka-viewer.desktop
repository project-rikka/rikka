[Desktop Entry]
Type=Application
Version=1.5
Name=Viewer
Name[ja]=ビューアー
Name[zh_CN]=查看器
GenericName=Media Viewer
GenericName[ja]=メディアビューアー
GenericName[zh_CN]=媒体查看器
Comment=Take a quick look at pictures, sound, film, models and text
Comment[ja]=画像・音声・動画・3Dモデル・テキストをすばやく確認します
Comment[zh_CN]=快速查看图片、音频、视频、3D 模型和文本
Exec=rikka-viewer %U
Icon=multimedia-photo-viewer
Terminal=false
Categories=Graphics;Viewer;
Keywords=view;image;photo;picture;psd;photoshop;music;audio;video;movie;model;3d;gltf;vrm;fbx;text;preview;
Keywords[ja]=表示;閲覧;画像;写真;フォトショップ;音楽;音声;動画;映像;モデル;3D;テキスト;プレビュー;
StartupNotify=true
