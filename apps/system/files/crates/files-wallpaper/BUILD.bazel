load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "files-wallpaper",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/files:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-dirs",
        "//crates/media/rikka-media-format",
        "//crates/session/rikka-seam",
        "//crates/session/rikka-settings",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":files-wallpaper",
        "//crates/foundation/rikka-dirs",
    ],
)
