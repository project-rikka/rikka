load("//bazel/rust:defs.bzl", "rikka_binary", "rikka_test")

rikka_binary(
    name = "rikka-video-thumbnailer",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//crates/graphics/rikka-image",
        "//crates/media/rikka-video",
    ],
)

rikka_test(
    name = "main",
    data = glob(
        ["tests/**"],
        allow_empty = True,
        exclude = ["tests/**/*.rs"],
    ) + [":rikka-video-thumbnailer"],
    deps = [
        "//crates/graphics/rikka-image",
        "//crates/media/rikka-video",
        "@crates//:tempfile",
    ],
)
