load("//bazel/rust:defs.bzl", "rikka_library")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "browser-preferences",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/browser:__subpackages__",
    ],
    deps = [
        "//apps/system/browser/crates/browser-model",
        "//apps/system/browser/crates/browser-pages",
        "//apps/system/browser/crates/browser-reader",
        "//apps/system/browser/crates/browser-translators",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-i18n",
        "//crates/foundation/rikka-languages",
        "//crates/foundation/rikka-types",
        "//crates/session/rikka-settings",
        "//crates/ui/rikka-ui",
        "//crates/web/rikka-web",
        "@crates//:serde",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "browser_preferences::Preferences::schema",
    deps = [":browser-preferences"],
)
