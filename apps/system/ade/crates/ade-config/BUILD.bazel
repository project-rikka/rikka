load("//bazel/rust:defs.bzl", "rikka_library")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "ade-config",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/ade:__subpackages__",
    ],
    deps = [
        "//crates/session/rikka-settings",
        "@crates//:serde",
        "@crates//:tracing",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "ade_config::Config::schema",
    deps = [":ade-config"],
)
