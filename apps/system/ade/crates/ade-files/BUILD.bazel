load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "ade-files",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/ade:__subpackages__",
    ],
    deps = [
        "//crates/desktop/rikka-file-operations",
        "@crates//:futures-util",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":ade-files",
        "//crates/desktop/rikka-file-operations",
        "@crates//:tempfile",
    ],
)
