load("@nix//:paths.bzl", "NIX")
load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "discord-voice",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/discord:__subpackages__",
    ],
    deps = [
        "//apps/system/discord/crates/discord-client",
        "//apps/system/discord/crates/discord-core",
        "//apps/system/discord/crates/discord-krisp",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-worker",
        "//crates/media/rikka-apm",
        "//crates/media/rikka-audio",
        "//crates/media/rikka-opus",
        "//crates/media/rikka-playout",
        "//crates/media/rikka-resample",
        "@crates//:futures-channel",
        "@crates//:futures-util",
        "@crates//:serde",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "machine",
    machine = True,
    rustc_env = {"RIKKA_DISCORD_KRISP": NIX["discord_krisp"]},
    deps = [
        ":discord-voice",
        "@crates//:futures-util",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
