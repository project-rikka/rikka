load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "discord-client",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/discord:__subpackages__",
    ],
    deps = [
        "//apps/system/discord/crates/discord-core",
        "//apps/system/discord/crates/discord-rate-limit",
        "//apps/system/discord/crates/discord-rtc",
        "//apps/system/discord/crates/discord-state",
        "//apps/system/discord/crates/discord-translate",
        "//apps/system/discord/crates/discord-wire",
        "//crates/desktop/rikka-account-book",
        "//crates/foundation/rikka-net",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "@crates//:base64",
        "@crates//:flate2",
        "@crates//:futures-channel",
        "@crates//:futures-util",
        "@crates//:jiff",
        "@crates//:mime_guess",
        "@crates//:percent-encoding",
        "@crates//:rand",
        "@crates//:rsa",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":discord-client",
        "//apps/system/discord/crates/discord-core",
    ],
)

exports_files(
    ["scripts/token.js"],
    visibility = ["//system/rikka-web-host:__pkg__"],
)
