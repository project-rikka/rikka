load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "music-spotify-wire",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/music:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-types",
        "//crates/foundation/rikka-xml",
        "@crates//:crypto-bigint",
        "@crates//:hmac",
        "@crates//:prost",
        "@crates//:rand",
        "@crates//:sha1",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    compile_data = glob(["tests/fixtures/*.bin"]),
    deps = [
        ":music-spotify-wire",
        "@crates//:rand",
    ],
)
