load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "music-stream",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/music:__subpackages__",
    ],
    deps = [
        "//apps/system/music/crates/music-core",
        "//crates/foundation/rikka-net",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-worker",
        "//crates/media/rikka-audio-decode",
        "//crates/media/rikka-hifi",
        "@crates//:futures-util",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":music-stream",
        "//apps/system/music/crates/music-core",
        "//crates/media/rikka-hifi",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

rikka_test(
    name = "machine",
    machine = True,
    deps = [
        ":music-stream",
        "//apps/system/music/crates/music-core",
        "//crates/media/rikka-hifi",
        "@crates//:tempfile",
    ],
)
