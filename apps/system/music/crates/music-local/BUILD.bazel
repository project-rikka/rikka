load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "music-local",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/music:__subpackages__",
    ],
    deps = [
        "//apps/system/music/crates/music-core",
        "//apps/system/music/crates/music-library",
        "//apps/system/music/crates/music-stream",
        "//crates/desktop/rikka-open",
        "//crates/graphics/rikka-symbols",
        "//crates/media/rikka-audio-tags",
        "//crates/media/rikka-hifi",
        "@crates//:futures-channel",
        "@crates//:rand",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":music-local",
        "//apps/system/music/crates/music-blend",
        "//apps/system/music/crates/music-core",
        "//apps/system/music/crates/music-library",
        "//crates/graphics/rikka-image",
        "//crates/media/rikka-hifi",
        "@crates//:lofty",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
