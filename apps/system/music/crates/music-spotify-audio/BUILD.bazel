load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "music-spotify-audio",
    target_compatible_with = ["@platforms//os:linux"],
    cranelift = False,
    visibility = [
        "//apps/system/music:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-file-format",
        "//crates/media/rikka-audio-decode",
        "@crates//:aes",
        "@crates//:ctr",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    compile_data = [
        "tests/fixtures/tone.encrypted",
        "tests/fixtures/tone.ogg",
    ],
    deps = [
        ":music-spotify-audio",
        "//crates/media/rikka-audio-decode",
    ],
)
