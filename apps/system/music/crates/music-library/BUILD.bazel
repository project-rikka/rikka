load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "music-library",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//apps/system/music:__subpackages__",
    ],
    deps = [
        "//apps/system/music/crates/music-core",
        "//apps/system/music/crates/music-tags",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-fs",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/foundation/rikka-watch",
        "//crates/foundation/rikka-worker",
        "//crates/graphics/rikka-image",
        "//crates/media/rikka-audio-decode",
        "@crates//:rusqlite",
        "@crates//:rustix",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":music-library",
        "//apps/system/music/crates/music-core",
        "//crates/graphics/rikka-image",
        "@crates//:lofty",
        "@crates//:rusqlite",
        "@crates//:tempfile",
    ],
)
