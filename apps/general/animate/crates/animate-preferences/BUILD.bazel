load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "animate-preferences",
    visibility = [
        "//apps/general/animate:__subpackages__",
    ],
    deps = [
        "//apps/general/animate/crates/animate-cast",
        "//apps/general/animate/crates/animate-export",
        "//apps/general/animate/crates/animate-fluid",
        "//apps/general/animate/crates/animate-library",
        "//crates/model/rikka-model",
        "//crates/physics/rikka-physics-tailor",
        "//crates/session/rikka-settings",
        "@crates//:serde",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":animate-preferences",
        "//apps/general/animate/crates/animate-library",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "animate_preferences::Preferences::schema",
    deps = [":animate-preferences"],
)
