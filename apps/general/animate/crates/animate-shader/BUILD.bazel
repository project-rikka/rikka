load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "animate-shader",
    visibility = [
        "//apps/general/animate:__subpackages__",
    ],
    deps = [
        "//apps/general/animate/crates/animate-look",
        "//crates/foundation/rikka-sync",
        "//crates/graphics/rikka-renderer-3d",
        "//crates/graphics/rikka-shader-compile",
        "//crates/graphics/rikka-shader-graph",
        "//crates/graphics/rikka-slang",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    limit = 180,
    deps = [
        ":animate-shader",
        "//apps/general/animate/crates/animate-look",
        "//crates/graphics/rikka-renderer-3d",
        "//crates/graphics/rikka-shader-graph",
        "//crates/model/rikka-mmd",
    ],
)
