load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "paint-document",
    visibility = [
        "//apps/general/paint:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-fs",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-figure",
