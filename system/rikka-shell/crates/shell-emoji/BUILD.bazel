load("//bazel/rust:defs.bzl", "rikka_library")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "shell-emoji",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//system/rikka-shell:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-emoji",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-theme",
        "//crates/session/rikka-seam",
        "//crates/session/rikka-session",
        "//crates/session/rikka-settings",
        "//crates/ui/rikka-ui",
        "//crates/ui/rikka-widgets",
        "//system/rikka-shell/crates/shell-kit",
        "@crates//:tracing",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "shell_emoji::Emoji::schema",
    deps = [":shell-emoji"],
)
