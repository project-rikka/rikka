# The types Rikka opens in its own applications. A person who prefers
# something else says so in their own mimeapps.list, which is read first.
#
# One file per session rather than one per application: the specification
# has the session's answer in a single mimeapps.list, and this is it.
[Default Applications]
image/png=rikka-viewer.desktop
image/jpeg=rikka-viewer.desktop
image/gif=rikka-viewer.desktop
image/webp=rikka-viewer.desktop
