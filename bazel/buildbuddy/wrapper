#!/usr/bin/env bash
set -euo pipefail

workspace="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

execution=local
if "$workspace/bazel/buildbuddy/api-key" >/dev/null 2>&1; then
    execution=remote
fi

selection="common --config=$execution"
rc="$workspace/.bazel/execution.bazelrc"
if [ ! -r "$rc" ] || [ "$(<"$rc")" != "$selection" ]; then
    mkdir -p "$workspace/.bazel"
    staged="$(mktemp "$rc.XXXXXX")"
    printf '%s\n' "$selection" >"$staged"
    mv -f "$staged" "$rc"
fi

exec "$BAZEL_REAL" "$@"
