startup --experimental_remote_repo_contents_cache

common --lockfile_mode=update
common --incompatible_strict_action_env
common --experimental_isolated_extension_usages
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --host_platform=//bazel/platforms:linux
common --platforms=//bazel/platforms:linux
common --nobuild_runfile_links
common --symlink_prefix=.bazel/
common --disk_cache=~/.cache/bazel/disk
common --experimental_disk_cache_gc_max_size=64G
common --experimental_disk_cache_gc_max_age=14d

common --@rules_rust//rust/settings:toolchain_generated_sysroot=false
common --@rules_rust//rust/settings:pipelined_compilation=true
common --@rules_rust//rust/settings:clippy_flag=-Dwarnings

try-import %workspace%/.bazel/execution.bazelrc

common:remote --credential_helper=*.buildbuddy.io=%workspace%/bazel/buildbuddy/credential-helper
common:remote --bes_backend=grpcs://remote.buildbuddy.io
common:remote --bes_results_url=https://app.buildbuddy.io/invocation/
common:remote --bes_upload_mode=fully_async
common:remote --build_metadata=VISIBILITY=PRIVATE
common:remote --remote_cache=grpcs://remote.buildbuddy.io
common:remote --remote_executor=grpcs://remote.buildbuddy.io
common:remote --experimental_remote_downloader=grpcs://remote.buildbuddy.io
common:remote --experimental_remote_downloader_local_fallback
common:remote --extra_execution_platforms=//bazel/platforms:rbe
common:remote --remote_download_outputs=minimal
common:remote --remote_cache_compression
common:remote --remote_timeout=10m
common:remote --jobs=240

common:cache --config=remote
common:cache --remote_executor=
common:cache --extra_execution_platforms=
common:cache --jobs=auto

common:local --remote_executor=
common:local --remote_cache=
common:local --bes_backend=
common:local --experimental_remote_downloader=
common:local --extra_execution_platforms=
common:local --jobs=auto

test --test_output=errors
test --test_tag_filters=-gpu,-machine,-wrapped
test --test_env=RIKKA_BLESS_GOLDEN

test:gpu --test_tag_filters=gpu
test:gpu --strategy=TestRunner=sandboxed
test:gpu --local_resources=gpu=4
test:gpu --test_env=VK_ICD_FILENAMES
test:gpu --test_env=VK_DRIVER_FILES
test:gpu --test_env=__NV_PRIME_RENDER_OFFLOAD
test:gpu --test_env=DRI_PRIME

test:machine --test_tag_filters=machine
test:machine --strategy=TestRunner=local
test:machine --test_env=XDG_RUNTIME_DIR
test:machine --test_env=XDG_SESSION_ID
test:machine --test_env=XDG_SEAT
test:machine --test_env=XDG_VTNR

common:release -c opt
common:release --@rules_rust//rust/settings:lto=fat
common:release --@rules_rust//rust/settings:codegen_units=1
common:release --@rules_rust//rust/settings:extra_rustc_flag=-Cpanic=abort

common:dist --config=release
common:dist --platforms=//bazel/platforms:linux_portable
common:dist --@rules_rust//rust/settings:extra_rustc_flag=-Ztranslate-remapped-path-to-local-path=no

common:windows --platforms=//bazel/platforms:windows
common:windows --experimental_platform_in_output_dir

common:installer -c opt
common:installer --platforms=//bazel/platforms:linux_musl
common:installer --@rules_rust//rust/settings:lto=fat
common:installer --@rules_rust//rust/settings:codegen_units=1
common:installer --@rules_rust//rust/settings:extra_rustc_flag=-Copt-level=z

common:bench -c opt
common:bench --@rules_rust//rust/settings:extra_rustc_flag=-Ctarget-cpu=x86-64-v3
common:bench --@rules_rust//rust/settings:extra_rustc_flag=-Cdebuginfo=line-tables-only
common:bench --@rules_rust//rust/settings:extra_rustc_flag=-Cstrip=none
common:bench --copt=-march=x86-64-v3
common:bench --copt=-fno-stack-protector
common:bench --copt=-fomit-frame-pointer

common:clippy --aspects=@rules_rust//rust:defs.bzl%rust_clippy_aspect
common:clippy --output_groups=+clippy_checks

common:rustfmt --aspects=@rules_rust//rust:defs.bzl%rustfmt_aspect
common:rustfmt --output_groups=+rustfmt_checks

common:check --config=clippy
common:check --config=rustfmt

try-import %workspace%/user.bazelrc
