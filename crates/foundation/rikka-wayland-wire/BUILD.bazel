load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-wayland-wire",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//system/rikka-compositor:__pkg__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-sync",
        "@crates//:rustix",
        "@crates//:slotmap",
        "@crates//:smallvec",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-wayland-wire",
        "@crates//:rustix",
    ],
)
