load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-computer",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-input",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/foundation/rikka-watch",
        "//crates/graphics/rikka-image",
        "//crates/session/rikka-capture",
        "//crates/session/rikka-seam",
        "//crates/session/rikka-session",
        "//crates/session/rikka-virtual-input",
        "@crates//:rustix",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-computer",
    ],
)
