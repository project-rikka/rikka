load("@nix//:paths.bzl", "NIX")
load("//bazel/rust:defs.bzl", "rikka_library")
load("//bazel/windows:defs.bzl", "windows_runtime")

rikka_library(
    name = "rikka-embedded-fonts",
    data = [":windows_runtime"],
    rustc_env = {
        "RIKKA_EMBEDDED_ICON_FONTS": NIX["icon_fonts"],
        "RIKKA_EMBEDDED_UI_FONTS": NIX["windows_runtime"] + "/share/rikka/fonts",
    },
    target_compatible_with = ["@platforms//os:windows"],
    visibility = [
        "//crates:__subpackages__",
    ],
)

windows_runtime(
    name = "windows_runtime",
    icon_font_licenses = {
        "FontAwesome-LICENSE.txt": "licenses/font-awesome/LICENSE.txt",
        "MaterialSymbols-LICENSE.txt": "licenses/material-symbols/LICENSE.txt",
    },
    licenses = [
        "inter",
        "jetbrains-mono",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)
