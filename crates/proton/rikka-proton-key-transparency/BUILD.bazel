load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-proton-key-transparency",
    compile_data = [
        "data/lets_encrypt.pem",
        "data/no_kt_domains.txt",
        "data/zero_ssl.pem",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-certificate-transparency",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/proton/rikka-proton-account",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-cache",
        "//crates/proton/rikka-proton-pgp",
