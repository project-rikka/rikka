load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-proton-drive-sync-state",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/proton/rikka-proton-names",
        "//crates/text/rikka-text-unicode",
        "@crates//:jiff",
        "@crates//:rusqlite",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-proton-drive-sync-state",
        "//crates/proton/rikka-proton-names",
        "@crates//:jiff",
        "@crates//:tempfile",
    ],
