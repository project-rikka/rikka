load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-proton-api",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-fs",
        "//crates/foundation/rikka-net",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "@crates//:base64",
        "@crates//:bytes",
        "@crates//:futures-util",
        "@crates//:http",
        "@crates//:jiff",
        "@crates//:percent-encoding",
        "@crates//:rand",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:url",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-proton-api",
        "//crates/proton/rikka-test-proton",
        "@crates//:base64",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)
