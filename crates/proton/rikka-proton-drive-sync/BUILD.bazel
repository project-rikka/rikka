load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-proton-drive-sync",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/desktop/rikka-trash",
        "//crates/foundation/rikka-fs",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/foundation/rikka-watch",
        "//crates/proton/rikka-proton-api",
        "//crates/proton/rikka-proton-drive",
        "//crates/proton/rikka-proton-drive-sync-state",
        "//crates/proton/rikka-proton-names",
        "//crates/proton/rikka-proton-pgp",
        "@crates//:futures-util",
        "@crates//:jiff",
        "@crates//:rustix",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-proton-drive-sync",
        "//crates/proton/rikka-proton-drive",
        "//crates/proton/rikka-test-proton-drive",
        "@crates//:jiff",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
