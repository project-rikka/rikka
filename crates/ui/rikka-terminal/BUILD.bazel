load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "rikka-terminal",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/desktop/rikka-open",
        "//crates/foundation/rikka-input",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-text",
        "//crates/graphics/rikka-theme",
        "//crates/session/rikka-settings",
        "//crates/ui/rikka-ui",
        "//crates/ui/rikka-widgets",
        "@crates//:alacritty_terminal",
        "@crates//:base64",
        "@crates//:rustix",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:unicode-width",
    ],
)

rikka_test(
    name = "main",
    gpu = True,
    deps = [
        ":rikka-terminal",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-renderer",
        "//crates/graphics/rikka-test-renderer",
        "//crates/graphics/rikka-theme",
        "//crates/ui/rikka-ui",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "rikka_terminal::Config::schema",
    deps = [":rikka-terminal"],
)
