load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-seat",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/desktop/rikka-xcursor",
        "//crates/foundation/rikka-input",
        "//crates/foundation/rikka-types",
        "//crates/foundation/rikka-wayland",
        "//crates/foundation/rikka-wayland-client",
        "@crates//:rustix",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-seat",
        "//crates/compositor/rikka-compositor-geometry",
        "//crates/compositor/rikka-compositor-protocols",
        "//crates/compositor/rikka-compositor-seat",
        "//crates/compositor/rikka-compositor-server",
        "//crates/compositor/rikka-compositor-surface",
        "//crates/compositor/rikka-compositor-types",
        "//crates/compositor/rikka-test-display",
        "//crates/foundation/rikka-input",
        "//crates/foundation/rikka-types",
        "//crates/foundation/rikka-wayland",
        "//crates/foundation/rikka-wayland-client",
    ],
)
