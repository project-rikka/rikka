rikka_test(
    name = "machine",
    machine = True,
    deps = [
        ":rikka-widgets",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-gpu",
        "//crates/graphics/rikka-picture",
        "//crates/graphics/rikka-renderer",
        "//crates/graphics/rikka-test-renderer",
        "//crates/graphics/rikka-theme",
        "//crates/ui/rikka-ui",
        "//crates/ui/rikka-ui-host",
        "@crates//:gbm",
        "@crates//:libc",
    ],
)
