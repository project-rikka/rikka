load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-widgets",
    proc_macro_deps = [
        "//crates/ui/rikka-ui-macros",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-i18n",
        "//crates/foundation/rikka-input",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-symbols",
        "//crates/graphics/rikka-text",
        "//crates/graphics/rikka-theme",
        "//crates/ui/rikka-animation",
        "//crates/ui/rikka-syntax",
        "//crates/ui/rikka-ui",
        "@crates//:rustc-hash",
    ],
)

rikka_test(
