load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")
load("//bazel/windows:defs.bzl", "windows_runtime")

rikka_library(
    name = "rikka-slang",
    data = select({
        "@platforms//os:windows": [":windows_runtime"],
        "//conditions:default": [],
    }),
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-sync",
        "//crates/graphics/rikka-spirv",
        "@crates//:libc",
        "@crates//:libloading",
        "@crates//:serde",
        "@crates//:thiserror",
    ],
)

windows_runtime(
    name = "windows_runtime",
    libraries = [
        "SPIRV-Tools-shared.dll",
        "slang.dll",
        "slang-compiler.dll",
        "slang-glsl-module.dll",
        "slang-glslang.dll",
    ],
    licenses = [
        "slang",
        "spirv-tools",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-slang",
    ],
)
