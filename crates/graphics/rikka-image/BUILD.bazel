load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-image",
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-image-ffmpeg",
        "//crates/graphics/rikka-image-resample",
        "//crates/graphics/rikka-png",
        "//crates/graphics/rikka-svg",
        "@crates//:bytemuck",
        "@crates//:image",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:webp",
