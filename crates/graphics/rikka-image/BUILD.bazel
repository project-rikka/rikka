    compile_data = [
        "tests/fixtures/animated.avif",
        "tests/fixtures/animated.jxl",
        "tests/fixtures/deep.j2k",
        "tests/fixtures/deep.jxl",
        "tests/fixtures/float.jxl",
        "tests/fixtures/gamma.icc",
        "tests/fixtures/grid.avif",
        "tests/fixtures/half.exr",
        "tests/fixtures/lossless.jxl",
        "tests/fixtures/lossy.jxl",
        "tests/fixtures/oriented.avif",
        "tests/fixtures/oriented.jxl",
        "tests/fixtures/oriented.tif",
        "tests/fixtures/photo.heic",
        "tests/fixtures/picture.jp2",
        "tests/fixtures/profile.icc",
        "tests/fixtures/tiles.heic",
    ],
    deps = [
        ":rikka-image",
        "//crates/foundation/rikka-deflate",
        "//crates/foundation/rikka-types",
        "@crates//:gif",
        "@crates//:png",
        "@crates//:tempfile",
