{
  "manifest_version": 3,
  "name": "Rikka",
  "description": "Connects Google Chrome to the Rikka desktop.",
  "version": "0",
  "minimum_chrome_version": "134",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "bookmarks",
    "browsingData",
    "clipboardWrite",
    "cookies",
    "downloads",
    "downloads.open",
    "downloads.ui",
    "favicon",
    "history",
    "identity",
    "identity.email",
    "management",
    "nativeMessaging",
    "privacy",
    "scripting",
    "sessions",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["context.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": []
}
