load("//bazel/rust:defs.bzl", "rikka_library")
load("//crates/web/rikka-web/extension:defs.bzl", "rikka_web_extension", "rikka_web_machine_test")

rikka_library(
    name = "rikka-web",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/desktop/rikka-clipboard",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-input",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-gpu-drivers",
        "//crates/graphics/rikka-picture",
        "//crates/ui/rikka-nested",
        "//crates/ui/rikka-ui",
        "//crates/web/rikka-web-crx",
        "@crates//:base64",
        "@crates//:futures-channel",
        "@crates//:getrandom",
        "@crates//:jiff",
        "@crates//:rustix",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_web_extension(
    name = "test_extension",
    testonly = True,
    scripts = {
        "rikka-web-test/loaded.js": "tests/loaded.js",
        "rikka-web-test/probe.js": "tests/probe.js",
    },
)

rikka_web_machine_test(
    name = "machine",
    extension = ":test_extension",
    deps = [
        ":rikka-web",
        "//crates/foundation/rikka-worker",
        "@crates//:futures-channel",
        "@crates//:futures-util",
        "@crates//:serde_json",
    ],
)
