load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-physics-cloth",
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-sync",
        "//crates/graphics/rikka-gpu",
        "//crates/graphics/rikka-renderer-3d",
        "//crates/model/rikka-model-core",
        "//crates/physics/rikka-physics-cloth/shaders:cloth_kernels",
        "//crates/physics/rikka-physics-gpu",
        "//crates/physics/rikka-physics-tailor",
        "@crates//:bytemuck",
        "@crates//:glam",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    compile_data = [
        "//crates/model/rikka-mmd:assets/mmd/miku.pmx",
        "//crates/model/rikka-mmd:assets/mmd/motion.vmd",
    ],
    gpu = True,
    limit = 300,
    shared = True,
    deps = [
        ":rikka-physics-cloth",
        "//crates/foundation/rikka-sync",
        "//crates/graphics/rikka-gpu",
        "//crates/model/rikka-humanoid",
        "//crates/model/rikka-mmd",
        "//crates/model/rikka-model-core",
        "//crates/physics/rikka-physics-tailor",
        "@crates//:bytemuck",
        "@crates//:glam",
        "@crates//:tracing-subscriber",
    ],
)

rikka_test(
    name = "machine",
    compile_data = [
        "//crates/model/rikka-mmd:assets/mmd/miku.pmx",
        "//crates/model/rikka-mmd:assets/mmd/motion.vmd",
    ],
    limit = 300,
    machine = True,
    shared = True,
    deps = [
        ":rikka-physics-cloth",
        "//crates/foundation/rikka-sync",
        "//crates/graphics/rikka-gpu",
        "//crates/model/rikka-humanoid",
        "//crates/model/rikka-mmd",
        "//crates/model/rikka-model-core",
        "//crates/physics/rikka-physics-tailor",
        "@crates//:glam",
        "@crates//:tracing-subscriber",
    ],
)
