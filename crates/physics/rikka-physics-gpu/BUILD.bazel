load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-physics-gpu",
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/graphics/rikka-gpu",
        "//crates/graphics/rikka-spirv",
        "//crates/physics/rikka-physics-gpu/shaders:scan_kernels",
        "@crates//:bytemuck",
    ],
