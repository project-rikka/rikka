load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-bus",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-worker",
        "@crates//:async-io",
        "@crates//:futures-channel",
        "@crates//:futures-util",
        "@crates//:serde",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:zbus",
        "@crates//:zvariant",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-bus",
        "//crates/daemons/rikka-test-objects",
        "//crates/foundation/rikka-test-bus",
        "@crates//:zbus",
    ],
)
