load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-sound",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/daemons/rikka-bus",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-fs",
        "//crates/foundation/rikka-pipewire",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-worker",
        "//crates/media/rikka-audio",
        "//crates/media/rikka-fft",
        "@crates//:futures-util",
        "@crates//:libspa",
        "@crates//:pipewire",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-sound",
        "@crates//:tempfile",
    ],
)
