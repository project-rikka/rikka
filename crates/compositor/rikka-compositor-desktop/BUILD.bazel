load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-compositor-desktop",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//system/rikka-compositor:__pkg__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/compositor/rikka-compositor-geometry",
        "//crates/compositor/rikka-compositor-protocols",
        "//crates/compositor/rikka-compositor-shell",
        "//crates/compositor/rikka-compositor-surface",
        "//crates/compositor/rikka-compositor-types",
        "//crates/foundation/rikka-wayland-wire",
        "@crates//:bitflags",
        "@crates//:rustc-hash",
        "@crates//:slotmap",
        "@crates//:smallvec",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-compositor-desktop",
        "//crates/compositor/rikka-compositor-geometry",
        "//crates/compositor/rikka-compositor-protocols",
        "//crates/compositor/rikka-compositor-shell",
        "//crates/compositor/rikka-compositor-surface",
        "//crates/compositor/rikka-compositor-types",
        "@crates//:slotmap",
    ],
)
