load("//bazel/rust:defs.bzl", "rikka_library")
load("//crates/foundation/rikka-wayland-protocols:defs.bzl", "rikka_wayland_protocols")

rikka_library(
    name = "rikka-compositor-protocols",
    target_compatible_with = ["@platforms//os:linux"],
    srcs = glob(["src/**/*.rs"]) + [":protocols"],
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//system/rikka-compositor:__pkg__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-wayland-protocols",
        "//crates/foundation/rikka-wayland-wire",
    ],
)

rikka_wayland_protocols(
    name = "protocols",
    out = "src/protocols.rs",
    side = "server",
)
