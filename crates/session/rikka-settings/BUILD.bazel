load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "rikka-settings",
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-fs",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/session/rikka-seam",
        "@crates//:futures-util",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:thiserror",
        "@crates//:toml",
        "@crates//:tracing",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "rikka_settings::session::catalog",
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-settings",
        "//crates/foundation/rikka-types",
        "//crates/session/rikka-test-seam",
        "@crates//:futures-util",
        "@crates//:serde",
        "@crates//:tempfile",
        "@crates//:tokio",
        "@crates//:toml",
    ],
)
