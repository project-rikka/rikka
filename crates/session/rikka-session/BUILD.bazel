load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")
load("//bazel/settings:defs.bzl", "rikka_settings_catalog")

rikka_library(
    name = "rikka-session",
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/session/rikka-seam",
        "//crates/session/rikka-settings",
        "@crates//:futures-util",
        "@crates//:serde",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-session",
        "@crates//:serde_json",
    ],
)

rikka_settings_catalog(
    name = "settings_catalog",
    catalog = "rikka_session::shortcuts::schema",
    deps = [":rikka-session"],
)
