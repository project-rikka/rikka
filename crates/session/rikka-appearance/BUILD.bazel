load("//bazel/rust:defs.bzl", "rikka_library")

rikka_library(
    name = "rikka-appearance",
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-types",
        "//crates/graphics/rikka-theme",
        "//crates/session/rikka-settings",
        "@crates//:tracing",
    ] + select({
        "@platforms//os:linux": [
            "//crates/session/rikka-seam",
        ],
        "@platforms//os:windows": [
            "@crates//:windows",
        ],
    }),
)
