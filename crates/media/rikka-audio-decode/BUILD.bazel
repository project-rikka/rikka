load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-audio-decode",
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "//crates/media/rikka-ffmpeg",
        "//crates/media/rikka-resample",
        "@crates//:thiserror",
        "@crates//:tracing",
    ],
)

rikka_test(
    name = "main",
    compile_data = glob(["tests/fixtures/*"]),
    deps = [
        ":rikka-audio-decode",
        "//crates/media/rikka-resample",
    ],
)
