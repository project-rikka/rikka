load("//bazel/rust:defs.bzl", "rikka_library")
load("//bazel/windows:defs.bzl", "windows_runtime")

rikka_library(
    name = "rikka-ffmpeg",
    cranelift = False,
    data = select({
        "@platforms//os:windows": [":windows_runtime"],
        "//conditions:default": [],
    }),
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "@crates//:libloading",
        "@crates//:thiserror",
    ] + select({
        "@platforms//os:windows": ["//crates/foundation/rikka-shipped"],
        "//conditions:default": [],
    }),
)

windows_runtime(
    name = "windows_runtime",
    libraries = [
        "avcodec-63.dll",
        "avformat-63.dll",
        "avutil-61.dll",
        "swresample-7.dll",
        "swscale-10.dll",
    ],
    licenses = ["ffmpeg"],
    target_compatible_with = ["@platforms//os:windows"],
)
