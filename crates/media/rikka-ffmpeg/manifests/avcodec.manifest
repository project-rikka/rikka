# libavcodec 62 manifest (FFmpeg 8 line)
# Source headers: C:/Users/eldod/Documents/Enviroment/ffmpeg/include/libavcodec/
# LIBAVCODEC_VERSION_MAJOR = 62 (version_major.h)
# FF_API_* gates evaluated (all "(LIBAVCODEC_VERSION_MAJOR < 63)", true at major 62):
#   FF_API_INIT_PACKET=true    -> AVPacketList / av_init_packet not transcribed (not in requested surface)
#   FF_API_CODEC_PROPS=true    -> AVCodecContext.properties field INCLUDED
#   FF_API_V408_CODECID, FF_API_EXR_GAMMA, FF_API_NVDEC_OLD_PIX_FMTS,
#   FF_API_PARSER_PRIVATE, FF_API_PARSER_CODECID: true but not applicable to any
#   transcribed struct/field in this subset.
# No bitfields encountered in any transcribed struct.
# AVCodec is transcribed PREFIX-only (name, long_name, type, id, capabilities);
#   remaining fields (max_lowres, deprecated supported_* arrays, priv_class,
#   profiles, wrapper_name, deprecated ch_layouts) intentionally omitted per task scope.
# AVProfile: not embedded by value in any transcribed struct/field (AVCodec.profiles
#   lies past the transcribed prefix), and not referenced elsewhere -> not declared at all.
# AVHWAccel, AVCodecDescriptor, AVCodecInternal: referenced only by pointer in
#   AVCodecContext; declared opaque rather than fully transcribed (out of requested scope).
# AVFrameSideData, AVAlphaMode, AV_NUM_DATA_POINTERS, AVMediaType, AVClass, AVFrame,
#   AVBufferRef, AVDictionary, AVChannelLayout, AVRational, AVPixelFormat,
#   AVColorSpace/Range/Primaries/TransferCharacteristic, AVChromaLocation,
#   AVHWDeviceType: assumed already defined in avutil.rs, imported via `use super::avutil::*;`.
# AVFieldOrder, AVAudioServiceType, AVSampleFormat: aliased locally in avcodec.rs per
#   task instruction (libavcodec/defs.h and libavutil/samplefmt.h respectively).
# AVCodecID = c_int (codec_id.h); AV_CODEC_ID_H264 value counted by hand from the
#   installed codec_id.h enum listing (28th entry, 0-indexed = 27): NONE=0,
#   MPEG1VIDEO..CYUV=1..26, H264=27.
# AVPacketSideDataType (packet.h enum) aliased locally as c_int; of its enumerators only
#   AV_PKT_DATA_DISPLAYMATRIX is transcribed, for reading a stream's display rotation.

