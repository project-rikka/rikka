load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-blend",
    visibility = [
        "//benchmarks:__subpackages__",
        "//crates:__subpackages__",
        "//xtask:__subpackages__",
    ],
    deps = [
        "//crates/foundation/rikka-types",
        "//crates/model/rikka-mesh-modifiers",
        "//crates/model/rikka-model-core",
        "//crates/model/rikka-polymesh",
        "@crates//:flate2",
        "@crates//:rustc-hash",
        "@crates//:zstd",
    ],
)

rikka_test(
    name = "main",
    data = glob(["assets/**"]),
    deps = [
        ":rikka-blend",
        "//crates/model/rikka-model-core",
        "@crates//:flate2",
    ],
)
