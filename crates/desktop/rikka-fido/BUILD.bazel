load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-fido",
    cranelift = False,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/foundation/rikka-public-suffix",
        "//crates/foundation/rikka-sync",
        "//crates/foundation/rikka-types",
        "@crates//:aes",
        "@crates//:aes-gcm",
        "@crates//:base64",
        "@crates//:cbc",
        "@crates//:flate2",
        "@crates//:getrandom",
        "@crates//:hmac",
        "@crates//:libc",
        "@crates//:p256",
        "@crates//:rustix",
        "@crates//:sha2",
        "@crates//:thiserror",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:udev",
        "@crates//:url",
        "@crates//:zeroize",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-fido",
        "//crates/desktop/rikka-test-fido",
        "@crates//:hmac",
        "@crates//:sha2",
    ],
)

rikka_test(
    name = "machine",
    machine = True,
    deps = [
        ":rikka-fido",
    ],
)
