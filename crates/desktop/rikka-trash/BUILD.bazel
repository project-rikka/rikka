load("//bazel/rust:defs.bzl", "rikka_library", "rikka_test")

rikka_library(
    name = "rikka-trash",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//crates/desktop/rikka-mounts",
        "//crates/desktop/rikka-open",
        "//crates/foundation/rikka-dirs",
        "//crates/foundation/rikka-format",
        "//crates/foundation/rikka-fs",
        "@crates//:jiff",
        "@crates//:rustix",
        "@crates//:thiserror",
    ],
)

rikka_test(
    name = "main",
    deps = [
        ":rikka-trash",
        "@crates//:tempfile",
    ],
)
