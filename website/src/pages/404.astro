---
import Base from "../layouts/Base.astro";
import { site } from "../site";
---

<Base title={`Not found · ${site.name}`} description={site.description}>
  <section class="container missing">
    <p class="code">404</p>
    <h1>This page does not exist.</h1>
    <a class="button" href="/">
      Back to {site.name}
    </a>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-block: clamp(96px, 16vw, 200px);
  }

  .code {
    color: var(--muted);
    font-family: var(--font-mono);
  }

  h1 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
</style>
