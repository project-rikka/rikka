<button
  type="button"
  class="toggle"
  data-theme-toggle
  aria-label="Dark theme"
  aria-pressed="false"
>
  <svg
    class="moon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"></path>
  </svg>
  <svg
    class="sun"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
  </svg>
</button>

<script>
  import { isVariant, type Variant } from "../../plugins/theme/variant";
  import { THEME_STORAGE_KEY } from "../theme/preference";

  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");

  const systemScheme = (): Variant => (system.matches ? "dark" : "light");

  const currentScheme = (): Variant => {
    const chosen = root.dataset["theme"];
    return isVariant(chosen) ? chosen : systemScheme();
  };

  const remember = (scheme: Variant | null) => {
    try {
      if (scheme === null) {
        localStorage.removeItem(THEME_STORAGE_KEY);
      } else {
        localStorage.setItem(THEME_STORAGE_KEY, scheme);
      }
    } catch (error) {
      console.warn(`theme: not remembered: ${String(error)}`);
    }
  };

  const paintBrowser = (scheme: Variant | null) => {
    for (const meta of document.querySelectorAll<HTMLMetaElement>(
      'meta[name="theme-color"]',
    )) {
      const shown = scheme ?? (meta.dataset["scheme"] as Variant);
      meta.content = meta.dataset[shown]!;
    }
  };

  const toggles = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-toggle]",
  );

  const reflect = () => {
    const pressed = String(currentScheme() === "dark");
    toggles.forEach((toggle) => toggle.setAttribute("aria-pressed", pressed));
  };

  toggles.forEach((toggle) =>
    toggle.addEventListener("click", () => {
      const next: Variant = currentScheme() === "dark" ? "light" : "dark";
      const chosen = next === systemScheme() ? null : next;
      if (chosen === null) {
        delete root.dataset["theme"];
      } else {
        root.dataset["theme"] = chosen;
      }
      remember(chosen);
      paintBrowser(chosen);
      reflect();
    }),
  );

  system.addEventListener("change", reflect);
  reflect();
</script>

<style>
  .toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: var(--corner-control);
    background: transparent;
    color: var(--subtext);
    cursor: pointer;
    transition:
      background-color var(--quick) var(--ease),
      color var(--quick) var(--ease);
  }

  .toggle:hover {
    background: var(--hover);
    color: var(--text);
  }

  .toggle:active {
    background: var(--press);
  }

  .sun {
    display: none;
  }

  :global(:root[data-theme="dark"]) .sun {
    display: block;
  }

  :global(:root[data-theme="dark"]) .moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .sun {
      display: block;
    }

    :global(:root:not([data-theme="light"])) .moon {
      display: none;
    }
  }
</style>
