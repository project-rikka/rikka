---
import { Picture } from "astro:assets";
import { markPath, markViewBox } from "../brand/mark";
import mascotImage from "../assets/rikka.webp";
import { mascot, site } from "../site";
import DiscordIcon from "./DiscordIcon.astro";
import GitHubIcon from "./GitHubIcon.astro";
import InstallCommand from "./InstallCommand.astro";
---

<section class="hero">
  <svg class="flake" viewBox={markViewBox} aria-hidden="true">
    <path d={markPath}></path>
  </svg>
  <div class="container copy">
    <h1>{site.name}</h1>
    <p class="lead">{site.description}</p>
    <div class="setup">
      <InstallCommand command={site.install} />
      <p class="note">
        Run from a NixOS live USB. Already on NixOS?
        <a href={site.existingNixos}>Add Rikka to your configuration</a>.
      </p>
    </div>
    <div class="actions">
      <a class="button" href={site.repository}>
        <GitHubIcon size={16} />
        View on GitHub
      </a>
      <a class="button" href={site.discord}>
        <DiscordIcon size={16} />
        Join Discord
      </a>
    </div>
  </div>
  <div class="mascot">
    <Picture
      src={mascotImage}
      alt={mascot.alt}
      width={800}
      widths={[400, 600, 800, mascotImage.width]}
      sizes="(min-width: 960px) 560px, 90vw"
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<style>
  .hero {
    --figure-width: clamp(380px, 38vw, 560px);
    --figure-edge: max(
      calc(var(--gutter) - 40px),
      calc((100% - var(--page)) / 2 - 40px)
    );

    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: clamp(640px, 100svh, 960px);
    overflow: clip;
  }

  .flake {
    position: absolute;
    z-index: -1;
    top: 50%;
    right: calc(var(--figure-edge) + var(--figure-width) / 2);
    width: calc(var(--figure-width) * 1.45);
    translate: 50% -54%;
    fill: none;
    stroke: color-mix(in oklab, var(--accent) 20%, transparent);
    stroke-width: 1px;
    stroke-linecap: round;
    mask-image: radial-gradient(closest-side, black 45%, transparent);
  }

  .flake path {
    vector-effect: non-scaling-stroke;
  }

  .copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: 28px;
    padding-block: clamp(48px, 8vw, 96px);
  }

  .copy > * {
    max-width: min(100%, 560px);
  }

  h1 {
    font-size: clamp(72px, 11vw, 148px);
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .lead {
    color: var(--subtext);
    font-size: clamp(17px, 1.7vw, 20px);
    line-height: 1.55;
  }

  .setup {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    width: min(100%, 500px);
  }

  .note {
    color: var(--muted);
    font-size: 13px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .mascot {
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 0;
    right: var(--figure-edge);
    width: var(--figure-width);
    pointer-events: none;
  }

  .mascot :global(img) {
    position: absolute;
    top: 4%;
    left: 50%;
    width: auto;
    max-width: none;
    height: 150%;
    translate: -50% 0;
    mask-image: linear-gradient(to bottom, black 38%, transparent 62%);
  }

  @media (max-width: 959px) {
    .hero {
      --figure-width: min(100%, 520px);

      align-items: start;
      min-height: 0;
    }

    .flake {
      top: auto;
      bottom: calc(min(640px, 130vw) * 0.5);
      right: 50%;
      translate: 50% 50%;
    }

    .copy {
      padding-bottom: 0;
    }

    .mascot {
      position: relative;
      inset: auto;
      width: auto;
      height: min(640px, 130vw);
      margin-top: 24px;
      overflow: clip;
    }

    .mascot :global(img) {
      height: 170%;
      top: 0;
    }
  }
</style>
