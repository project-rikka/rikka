load("//bazel/minecraft:defs.bzl", "fabric_mod", "minecraft_client", "minecraft_sources")

exports_files([
    "minecraft.lock.json",
    "src/main/resources/assets/rikka/textures/gui/project-rikka.jpg",
])

fabric_mod(
    name = "rikka",
    srcs = glob(["src/main/java/**/*.java"]),
    deps = ["//sdk/bindings/java"],
    resources = glob(["src/main/resources/**"]),
    version = "0.1.0",
    visibility = ["//benchmarks/minecraft:__pkg__"],
)

minecraft_client(
    name = "client",
    mods = [":rikka"],
    tags = ["manual"],
)

minecraft_sources(
    name = "sources",
    tags = ["manual"],
)
