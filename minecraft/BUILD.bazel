load("//bazel/minecraft:defs.bzl", "fabric_mod", "minecraft_client", "minecraft_sources")
load("//bazel/windows:defs.bzl", "windows_zip")

exports_files(["minecraft.lock.json"])

windows_zip(
    name = "windows_natives",
    out = "rikka-natives-windows-x86_64.zip",
    libraries = {"//sdk/native:rikka": ""},
)

fabric_mod(
    name = "rikka",
    srcs = glob(["src/main/java/**/*.java"]),
    natives = {":windows_natives": "natives/windows-x86_64.zip"},
    deps = ["//sdk/bindings/java"],
    resources = glob(["src/main/resources/**"]),
    version = "0.1.0",
)

minecraft_client(
    name = "client",
    mods = [":rikka"],
    tags = ["manual"],
)

minecraft_sources(
    name = "sources",
    tags = ["manual"],
)
