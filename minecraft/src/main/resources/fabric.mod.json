{
	"schemaVersion": 1,
	"id": "rikka",
	"version": "${version}",
	"name": "Rikka Client",
	"description": "A Minecraft PvP client for Rikka.",
	"environment": "client",
	"entrypoints": {
		"preLaunch": [
			"sh.rikka.client.natives.NativeLibraries"
		],
		"client": [
			"sh.rikka.client.RikkaClient"
		]
	},
	"mixins": [
		"rikka.mixins.json",
		"rikka.culling.mixins.json",
		"rikka.entity.mixins.json",
		"rikka.memory.mixins.json",
		"rikka.scale.mixins.json",
		"rikka.simulation.mixins.json",
		"rikka.terrain.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_release}"
	}
}
